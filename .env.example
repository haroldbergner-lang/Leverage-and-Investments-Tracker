# Copy this file to .env for local testing/running. This project runs
# entirely on your own Mac (see README.md) — there is no cloud deployment,
# so these are just local environment variables, not GitHub secrets.

# --- Email delivery (Gmail SMTP) ---
# GMAIL_APP_PASSWORD is a 16-character app password, not your regular Gmail
# password: Google Account -> Security -> 2-Step Verification -> App Passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=haroldbergner@gmail.com
