# Copy this file to .env for local testing. In production (GitHub Actions),
# these are set as repository secrets instead — see README.md.

# --- Email delivery (Gmail SMTP) ---
# GMAIL_APP_PASSWORD is a 16-character app password, not your regular Gmail
# password: Google Account -> Security -> 2-Step Verification -> App Passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=haroldbergner@gmail.com
